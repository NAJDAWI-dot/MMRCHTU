# Supabase exposes two connection strings under Project Settings > Database.
# Application queries use the pooled connection (port 6543); Prisma migrations
# need the direct one (port 5432), because the pooler cannot run the statements
# a migration issues.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Signs admin session cookies. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-long-random-hex-string"

# Used once, on first run, to create the initial admin account. Changing these
# afterwards does NOT change an existing admin's password.
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD="change-me"

# Resend API key for outbound email. Until a sending domain is verified, Resend
# only delivers to the address that owns the account.
RESEND_API_KEY=
RESEND_FROM_EMAIL="MMRC 26 <support@mmrchtu.tech>"
ADMIN_NOTIFICATION_EMAIL=

# Public base URL used to build links inside emails. Leave unset locally — the
# app derives it from the request host. Set it in production.
# SITE_URL="https://your-domain"

# Lets a spreadsheet read the registration export without logging in, so an
# Excel workbook can refresh itself (Data > Get Data > From Web). Excel cannot
# hold an admin session, which is the only reason this exists.
#
# Anyone holding this token can read every registrant's name, email, WhatsApp
# number and university, with no account and no audit trail. Treat any URL it
# appears in as a password: keep the workbook off shared drives, and rotate
# this value if it is ever pasted somewhere it should not be.
#
# Leave it unset to switch the feed off — the admin Registrations page keeps
# its download buttons either way. Must be at least 32 characters, or it is
# refused rather than honoured. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REGISTRATIONS_EXPORT_TOKEN=
