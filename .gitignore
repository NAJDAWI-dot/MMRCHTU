# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# env — every variant, so a backup or a per-environment copy cannot be
# committed by accident. This repository is public; .env.example is the only
# env file that belongs in it.
.env
.env.*
!.env.example

# prisma
/prisma/dev.db
/prisma/dev.db-journal

# testing
/coverage
/playwright-report
/test-results

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*

.vercel

# The Vercel CLI appends a bare `.env*` here on link. Left in place it would
# sit after the negation above and re-ignore .env.example, since later rules
# win — the env patterns are already covered on lines 18-20.
