datasource db {
  provider  = "postgresql"
  // Supabase gives two connection strings. Application queries go through the
  // pooled one (port 6543); migrations need the direct one (port 5432) because
  // the pooler cannot run the statements a migration issues.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Status is a plain String constrained at the application layer (see
// RegistrationStatus in src/lib/registration.ts), which keeps the allowed
// values next to the code that reads them. Promoting it to a real Postgres
// enum would be a schema-only change.
model Registration {
  id                  String   @id @default(cuid())
  teamName            String
  submitterEmail      String
  memberCount         Int      @default(1)
  technicalExperience String
  motivation          String
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())

  /// Payment is tracked separately from `status`: a team can be CONFIRMED on
  /// merit while its fee is still outstanding, and refusing a payment must not
  /// silently cancel a registration. See PaymentStatus in src/lib/payment.ts.
  paymentStatus      String    @default("UNPAID")
  /// The CliQ transaction reference the team reports, normalised on the way in.
  paymentReference   String?
  /// Stored in fils (1 JOD = 1000) so money is never a float.
  paymentAmountFils  Int?
  paymentSubmittedAt DateTime?
  paymentVerifiedAt  DateTime?
  /// The username of the admin who marked this payment verified, snapshotted at
  /// that moment.
  ///
  /// A string rather than a relation to AdminUser. Who accepted a team's money
  /// is a record of a decision already taken, in the same way feeDueFils records
  /// what a team was quoted rather than what the price list says today. A
  /// foreign key would either erase that record when the account is deleted, or
  /// refuse to let an admin who has ever approved anything be deleted at all,
  /// and neither is wanted. Null on rows verified before this column existed,
  /// and cleared alongside paymentVerifiedAt whenever a payment stops being
  /// verified, so a name never outlives the fact it attests to.
  paymentVerifiedBy  String?
  /// Admin-facing: why a payment was refused, or any reconciliation note.
  paymentNote        String?

  /// Who last set `paymentStatus`, and when — for every status, not only
  /// VERIFIED.
  ///
  /// The pair above records one specific fact: that money was confirmed
  /// received. They are cleared when a verification is withdrawn, because a
  /// name left standing against a payment that is no longer verified would be
  /// a claim nobody made. That is right for what they mean, and it is exactly
  /// why they cannot answer the question an admin asks far more often —
  /// "who marked this one Not matched, and when?"
  ///
  /// These two answer that. Written on every transition and never cleared, so
  /// the row always says who touched it last. Null on rows whose status was
  /// last changed before this column existed.
  paymentStatusBy String?
  paymentStatusAt DateTime?

  /// Proof of payment: a screenshot of the team's CliQ confirmation. Same
  /// url/key pair as GalleryPhoto — the key is kept so deleting a registration
  /// can delete the file rather than orphaning it in the blob store.
  paymentScreenshotUrl String?
  paymentScreenshotKey String?

  /// The legal name of the person whose account the transfer came from, in the
  /// four parts a Jordanian bank account carries it in.
  ///
  /// Kept apart from the team's own names on purpose. A fee is very often sent
  /// by a parent, a sibling or one member on behalf of the rest, so the name on
  /// the CliQ line in the statement is regularly nobody listed in TeamMember —
  /// and matching a transfer is exactly the job of reading that name off the
  /// statement and finding the team it belongs to.
  ///
  /// Stored as four columns rather than one joined string because that is how
  /// the bank holds it, and a name that arrives in parts can always be joined
  /// for display while a joined one cannot be reliably split back.
  ///
  /// Blank is meaningful and is the default: it means a registration made
  /// before this was asked for, not a team that declined to answer.
  payerFirstName  String @default("")
  payerSecondName String @default("")
  payerThirdName  String @default("")
  payerLastName   String @default("")

  /// Which of the three team-wide tiers this registration is priced at.
  /// Deliberately distinct from TeamMember.ieeeStatus: that stays a per-person
  /// record, while the fee is one flat price for the whole team. See FeeTier in
  /// src/lib/pricing.ts.
  feeTier String @default("NON_MEMBER")

  /// What the team was quoted, in fils, frozen at the moment they registered.
  ///
  /// Not recomputed from PaymentConfig on read: prices and the early-bird
  /// window both change over time, and a team that registered at the early
  /// price must not find their balance quietly raised afterwards. Nullable only
  /// for rows created before pricing existed.
  feeBaseFils     Int?
  feeDiscountFils Int?
  feeDueFils      Int?

  /// Legal consent captured at stage one. The version is whatever
  /// CONSENT_VERSION said at the time, so rewriting the legal pages later never
  /// retroactively changes what an old registration agreed to.
  consentAcceptedAt DateTime?
  consentVersion    String?

  /// Lets a team reopen stage two at /register?code=… after leaving to make the
  /// transfer in their banking app. Nullable because registrations predating
  /// this flow genuinely have no code; Postgres allows many NULLs under a
  /// unique constraint.
  resumeCode String? @unique

  /// The ambassador referral code the team typed, normalised. Kept as text as
  /// well as the link below, so removing an ambassador still leaves a record of
  /// which code a team came in on. Blank when no code was given.
  referralCode String      @default("")
  /// Set only when the code belonged to an active ambassador at the moment of
  /// registering. This is what the Ambassadors tab counts.
  ambassadorId String?
  ambassador   Ambassador? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)

  members TeamMember[]

  /// Competition day: check-in and inspection, qualifying runs, and the
  /// knockout matches this team is drawn into. See src/lib/bracket.ts.
  dayStatus      TeamDayStatus?
  qualifyingRuns QualifyingRun[]
  matchesAsA     KnockoutMatch[] @relation("MatchTeamA")
  matchesAsB     KnockoutMatch[] @relation("MatchTeamB")

  @@index([status])
  @@index([paymentStatus])
  @@index([ambassadorId])
}

// A university ambassador and their referral code. `status` is ACTIVE or
// PAUSED (see src/lib/referral.ts). A paused code is refused on the register
// form but keeps the registrations it already brought in.
model Ambassador {
  id         String   @id @default(cuid())
  name       String
  university String   @default("")
  code       String   @unique
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  registrations Registration[]
}

model TeamMember {
  id               String       @id @default(cuid())
  registrationId   String
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  order            Int
  firstName        String
  lastName         String
  email            String
  whatsapp         String
  university       String
  major            String
  ieeeStatus       String
  ieeeMembershipId String

  @@index([registrationId])
}

// Generic key/value counters so new live stats (submissions, game_plays, ...)
// can be added later without a schema migration.
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// What lastLoginAt held before the current session began.
  ///
  /// lastLoginAt is overwritten at sign-in, so by the time any page renders it
  /// describes the very session doing the reading — telling an admin they were
  /// last here "3 hours ago" when that is their own sign-in is not a fact worth
  /// showing. This keeps the one before it, which is the only value that can
  /// honestly be called the last time they were here.
  ///
  /// Nullable, and null means two different things: a genuinely first sign-in,
  /// or a row that predates this column. The greeting tells them apart by the
  /// account's age rather than guessing.
  previousLoginAt DateTime?

  /// Invalidates every session this admin currently holds when incremented.
  ///
  /// Sessions are stateless HMAC tokens, so without this there is no way to
  /// revoke one: a stolen cookie stayed valid for its full seven days and
  /// changing the password did nothing about it. The number is signed into the
  /// token and compared on every request, so bumping it makes every token
  /// issued before now fail to verify.
  tokenVersion Int @default(0)

  /// Which admin screens this account opens: a comma-separated list of the
  /// roles in src/lib/roles.ts ("MASTER", "SCORING,MEDIA"). Master opens
  /// everything. Every account that existed before roles did was made Master
  /// by the migration, so nobody lost a screen they already used.
  roles String @default("")
}

model ScheduleEvent {
  id          String    @id @default(cuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt])
}

model FaqEntry {
  id          String   @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Visitor-submitted questions not yet in the published FaqEntry list.
model FaqQuestion {
  id         String    @id @default(cuid())
  question   String
  askerEmail String?
  reply      String?
  repliedAt  DateTime?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())

  @@index([status])
}

// A named audience the admin can broadcast email to. `kind` is a plain String
// (same tradeoff as Registration.status) constrained at the application
// layer by BroadcastListKind in src/lib/broadcast.ts. CONFIRMED
// and WAITING lists are seeded from registration status via the "import from
// registrations" action, but stay ordinary editable lists afterwards — the
// admin can always add or remove people by hand.
model BroadcastList {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("CUSTOM")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts   BroadcastContact[]
  broadcasts Broadcast[]

  @@index([kind])
}

model BroadcastContact {
  id      String        @id @default(cuid())
  listId  String
  list    BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email   String
  name    String        @default("")
  // "MANUAL" for hand-entered rows, "REGISTRATION" for rows pulled in by the
  // import action — lets a re-import top up a list without duplicating or
  // clobbering people the admin added themselves.
  source  String        @default("MANUAL")
  addedAt DateTime      @default(now())

  @@unique([listId, email])
  @@index([listId])
}

// One row per email: the one being written, the one saved to start from next
// time, and the one already sent. Three states of the same thing rather than
// three tables, because a draft becomes a sent record without anything being
// copied, and the send log is then literally the email that went out.
model Broadcast {
  id     String         @id @default(cuid())
  /// Null only for a TEMPLATE, which by definition belongs to no one list.
  listId String?
  list   BroadcastList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  subject String
  /// The plain-text rendition, which is also every pre-rich-text broadcast's
  /// only body. Written on every send, so the log stays readable whatever the
  /// email was composed in, and so a mail client that refuses HTML has words.
  body    String

  /// The email as authored, exactly as the editor left it.
  ///
  /// Stored raw rather than sanitised: what is safe to *send* is decided at
  /// render time by src/lib/rich-text.ts, and storing only the cleaned form
  /// would mean reopening a draft in the editor loses whatever the cleaner
  /// dropped, silently, with no way to get it back. Nothing renders this
  /// without going through that module.
  bodyHtml String @default("")

  /// The wording around the message, editable per email with a saved default.
  /// {name} in the greeting is the recipient's own name where one is known.
  greeting   String @default("")
  signOff    String @default("")
  footerNote String @default("")

  /// The call-to-action buttons, as a JSON array of {label, href}. JSON rather
  /// than a table because they are read and written only as a whole, always
  /// belong to exactly one email, and are never queried across emails.
  buttons String @default("[]")

  /// Extra recipients, comma separated. Each receives ONE copy of the email —
  /// not one per contact — which is the only reading that makes sense when the
  /// list itself is sent as individual private messages.
  cc  String @default("")
  bcc String @default("")

  /// DRAFT, SENDING, SENT or TEMPLATE. See BROADCAST_STATUSES in
  /// src/lib/broadcast.ts. Defaulted to SENT so every row written before drafts
  /// existed keeps meaning what it meant: an email that went out.
  status String @default("SENT")
  /// What a TEMPLATE is called in the picker. Empty for the others.
  name   String @default("")

  /// Who this email is going to, frozen at the moment sending began, as JSON
  /// [{email, name}].
  ///
  /// A snapshot rather than a re-query per batch. A large send runs as a series
  /// of requests, and the position in the list is an offset — so a contact
  /// added or removed while it runs would shift every later offset and either
  /// skip somebody or send to them twice. Empty until a send starts.
  recipients String @default("")

  /// The addresses that failed, accumulated across batches, comma separated.
  /// Kept because "3 failed" without saying which three is not a report anyone
  /// can act on.
  failedEmails String @default("")

  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  /// When it was sent — and, for a draft, when it was started.
  sentAt      DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  attachments BroadcastAttachment[]

  @@index([listId])
  @@index([status])
}

// A file that rides along with one email. Same url/key pair as GalleryPhoto and
// the payment screenshots, for the same reason: the key is what lets deleting
// the row delete the file rather than orphaning it in the blob store.
model BroadcastAttachment {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  /// The name the recipient sees. Sanitised on the way in — never the raw
  /// upload name, which is attacker-controlled on any public form and merely
  /// untidy on this one.
  filename    String
  url         String
  key         String
  contentType String
  /// Bytes, kept so the composer can total a message before it is refused by
  /// the mail provider rather than after.
  size        Int
  addedAt     DateTime  @default(now())

  @@index([broadcastId])
}

// Pac Mouse leaderboard. `mode` separates the Classic and First-Person boards
// since their scoring pace differs enough that one combined board would be
// dominated by a single mode.
model GameScore {
  id         String   @id @default(cuid())
  playerName String
  score      Int
  level      Int      @default(1)
  mode       String   @default("classic")
  createdAt  DateTime @default(now())

  /// Which board a run belongs to. Empty string for the public board on
  /// /game; a slug like "open-day" for a board that only counts runs played
  /// at one event, so a stand at a university ranks its own visitors against
  /// each other rather than against months of accumulated scores.
  ///
  /// The allowed values live in src/lib/leaderboard.ts (SCORE_EVENTS) rather
  /// than in an enum here, for the same reason the statuses elsewhere are
  /// plain strings: adding next year's event should not need a migration.
  event String @default("")

  @@index([mode, score])
  @@index([event, mode, score])
}

// Singleton row (id is always "singleton") holding admin-editable copy and
// publication status for the public competition day page.
//
// `status` is a plain String — the allowed values live in
// src/lib/competition-day.ts, the same pattern as BroadcastList.kind.
model CompetitionDayConfig {
  id     String @id @default("singleton")
  status String @default("COMING_SOON") // "HIDDEN" | "COMING_SOON" | "PUBLISHED"

  headline String @default("Competition Day")
  intro    String @default("Everything you need to know about the day itself.")

  // Shown instead of the details below until the status is flipped to PUBLISHED.
  comingSoonText String @default("Details will be released as soon as possible.")

  // The real content, revealed when PUBLISHED. Plain text rather than HTML —
  // blank lines separate paragraphs — so admin input can never inject markup.
  dateText String @default("")
  venue    String @default("")
  details  String @default("")

  // Machine-readable counterpart to dateText, and the only thing the countdown
  // can use — "Saturday, 14 March" cannot be counted down to. Kept separate
  // rather than replacing dateText, the same split RegisterFormConfig uses for
  // deadlineText/deadlineDate: the prose can say "mid-March, exact time TBC"
  // while the clock still has something exact to run against. Optional, so the
  // countdown simply does not appear until a date is set.
  eventDate DateTime?

  // Day mode: while on, the homepage becomes the competition day site and the
  // pages in DAY_MODE_HIDDEN_PAGES (src/lib/day-mode.ts) go dark. Off by
  // default, so adding the column changes nothing until an admin flips it.
  dayMode Boolean @default(false)

  // Who can open the day site under /day. PRIVATE: only the admins listed in
  // dayViewerIds. STAFF: any signed-in admin. PUBLIC: everyone, and the
  // homepage hands over to it (dayMode is kept equal to PUBLIC).
  dayAudience  String @default("PRIVATE")
  dayViewerIds String @default("")

  // Phase one, the qualifying round. Its format is not decided yet, so it is
  // kept general: any number of runs per team, the best one counts, and which
  // way is "best" is a setting. NOT_SET | OPEN | LOCKED.
  qualifyingStatus    String @default("NOT_SET")
  qualifyingDirection String @default("HIGHER")
  qualifyingNote      String @default("")

  // Head-to-head results use the same direction unless told otherwise.
  matchDirection String @default("HIGHER")

  // The phase 1 running order: when the first team runs, how long each slot
  // is, and when the order was drawn.
  runOrderStart   String    @default("")
  runSlotMinutes  Int       @default(10)
  runOrderDrawnAt DateTime?

  // The call queue on the qualifying desk: the team on the maze right now
  // (empty when nobody has been called) and when it was called. The teams on
  // deck and in the hole are worked out from the running order, never stored.
  queueTeamId   String    @default("")
  queueCalledAt DateTime?
  // The teams on the maze before this one, oldest first, comma-separated: what
  // "Back one" steps back through.
  queueHistory  String    @default("")

  // The gallery album the Photos desk uploads into, shown live on the day
  // site and the hall screen. Empty until someone starts it.
  dayAlbumId String @default("")

  updatedAt DateTime @updatedAt
}

// A team's day: arrived, robot inspected, where it is parked. One row per
// team, created the first time the check-in desk touches it.
model TeamDayStatus {
  registrationId String       @id
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  checkedInAt DateTime?
  checkedInBy String    @default("")

  // PENDING | PASSED | FAILED. See INSPECTION_STATES in src/lib/bracket.ts.
  inspection     String @default("PENDING")
  inspectionNote String @default("")

  robotName String  @default("")
  pit       String  @default("")
  withdrawn Boolean @default(false)

  // The registration desk's own record: which members turned up (ids of
  // TeamMember rows, comma-separated), whether badges went out, and a note
  // only the desk sees.
  presentIds String  @default("")
  badges     Boolean @default(false)
  deskNote   String  @default("")

  // Place in the phase 1 running order, 1-based, once it has been drawn.
  runOrder Int?

  updatedAt DateTime @updatedAt
}

// A team's phase 1 match sheet: the time of every run that reached the
// centre. The score is worked out from them by the rulebook formula,
// (successful runs / fastest time) * 1000, and kept here so nothing has to
// recompute it to sort. A mouse that never reached the centre has no score and
// is ranked by `remaining`, how many cells short of the centre it stopped.
// Rows from before run times were recorded have a score and no times.
model QualifyingRun {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  score          Float?
  runTimes       Float[]      @default([])
  remaining      Float?
  note           String       @default("")
  recordedBy     String       @default("")
  createdAt      DateTime     @default(now())

  @@index([registrationId])
}

// A head-to-head match in the knockout. Round 2 is the round of 32, then 16,
// quarter-finals, semi-finals and the final at round 6. Slot is the position
// in the round; the winners of slots 2k and 2k+1 meet in slot k of the next.
model KnockoutMatch {
  id    String @id @default(cuid())
  round Int
  slot  Int

  teamAId String?
  teamA   Registration? @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamBId String?
  teamB   Registration? @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  seedA   Int?
  seedB   Int?

  scoreA   Float?
  scoreB   Float?
  winnerId String?

  // The same match sheet as qualifying, one per side: every successful run's
  // time, and the distance short of the centre for a side that never got there.
  timesA     Float[] @default([])
  timesB     Float[] @default([])
  remainingA Float?
  remainingB Float?

  // PENDING | LIVE | DONE
  status      String    @default("PENDING")
  scheduledAt DateTime?
  arena       String    @default("")
  updatedBy   String    @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([round, slot])
}

// Somebody helping on the day. Name, role and station are shown on the day
// site; the phone number never is.
model Volunteer {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("")
  station     String   @default("")
  shift       String   @default("")
  phone       String   @default("")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// The long-form pages of the day site: competitors, volunteers, organizers,
// venue. Plain text, blank lines between paragraphs, a line starting "## "
// for a heading. Rendered as React children, never as markup.
model DayGuide {
  slug      String   @id
  title     String
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

// A short notice on the competition day site: "Round two starts at 14:00",
// "Team Byte, please come to the inspection desk". Plain text, rendered as
// React children, so an admin cannot inject markup. Pinned ones sit above the
// rest; otherwise the newest is first.
// One line of the competition day's running order, written on the Competition
// Day screen. Times are clock times on the day ("09:00"), in Amman time, and
// the date comes from CompetitionDayConfig.eventDate.
model DaySlot {
  id        String   @id @default(cuid())
  startTime String
  endTime   String   @default("")
  title     String
  location  String   @default("")
  detail    String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
}

model DayAnnouncement {
  id          String   @id @default(cuid())
  title       String   @default("")
  body        String
  // An alert pops up over the day site, and once a visitor dismisses it,
  // stays in the thin banner at the top until an admin edits or clears it.
  isAlert     Boolean  @default(false)
  // INFO | URGENT | GOOD
  tone        String   @default("INFO")
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

// The open day stand: when it runs, where it is, and where its clock appears.
//
// Its own row rather than fields on CompetitionDayConfig, which describes the
// competition itself. They are two different events months apart, with two
// different pages and two different clocks, and folding them together would
// mean an admin editing the competition to move a stand.
model OpenDayConfig {
  id String @id @default("singleton")

  // The master switch for the clock. Off takes it off the open day page and
  // takes the slider off the homepage; the open day page itself stays up,
  // which is the Pages tab's job rather than this one's.
  enabled Boolean @default(true)

  // Both optional, the same arrangement as CompetitionDayConfig.eventDate: no
  // date set simply means the page falls back to the dates in the code rather
  // than counting down to nothing.
  startsAt DateTime?
  endsAt   DateTime?

  // Where the stand is, shown under the clock. Plain text rendered as React
  // children, never as markup, so an admin cannot inject anything.
  location String @default("")

  // A map link for that place, kept out of the text above it. Pasted into the
  // location, a maps URL printed as forty characters of raw link in the middle
  // of a sentence on the homepage. Validated to http or https before it is
  // stored, so what ends up in an href cannot be a javascript: URL.
  mapUrl String @default("")

  // Whether the slider rides at the top of the homepage. It takes itself down
  // once the day is over whatever this says, since a homepage advertising
  // yesterday is worse than one saying nothing.
  showOnHome Boolean @default(true)

  // Keeps the open day page shut until the countdown reaches zero. Visitors
  // who follow the link get the clock and nothing else; the crests, the wall
  // and the board open when the doors do. Signed-in admins are let through,
  // so the page can be checked before the day rather than on it.
  lockUntilOpen Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// A set of photos from one event — "MMRC 26 Finals", "Build Workshop". Albums
// rather than one flat stream so each year's competition stays its own recap
// instead of silting up a single endless feed.
model GalleryAlbum {
  id          String    @id @default(cuid())
  title       String
  // Used in the public URL, so it is unique and generated from the title.
  slug        String    @unique
  description String    @default("")
  eventDate   DateTime?
  // Albums start hidden so photos can be uploaded and ordered before anyone
  // sees a half-filled album.
  isPublished Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  photos GalleryPhoto[]

  @@index([isPublished])
}

model GalleryPhoto {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  // Public URL of the stored image.
  url        String
  // Key in blob storage, kept so deleting the row can delete the file too and
  // the store does not fill with orphans nobody can find.
  storageKey String   @default("")
  caption    String   @default("")
  // Recorded at upload so the page can reserve the right space and avoid the
  // layout jumping as each image arrives.
  width      Int?
  height     Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([albumId])
}

// Whether a public page is reachable, one row per page the admin has taken a
// decision about.
//
// Sparse on purpose: a missing row means visible, so nothing has to be seeded
// and adding a page to MANAGED_PAGES in src/lib/pages.ts needs no migration.
// The href is the primary key rather than a surrogate id — there is exactly one
// decision per page, and keying on the path makes a duplicate impossible rather
// than merely unlikely.
//
// Distinct from CompetitionDayConfig.status and GalleryAlbum.isPublished, which
// hide their pages for reasons of their own: those describe whether there is
// anything to show, this is an admin saying "not yet" regardless. Either one
// hiding a page hides it.
model PageVisibility {
  href      String   @id
  isHidden  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Singleton row (id is always "singleton") holding admin-editable copy for
// the public register page.
model RegisterFormConfig {
  id           String    @id @default("singleton")
  deadlineText String    @default("Registration closes soon. Check back for the exact date.")
  deadlineDate DateTime?
  /// Human-written prose about the fee. Descriptive only — the amount actually
  /// charged comes from PaymentConfig's per-tier prices, so this can say
  /// whatever reads best without anyone worrying it drives arithmetic.
  feeInfoText  String    @default("35 JD (non-member) / 25 JD (IEEE member) / 15 JD (IEEE RAS member) per team.")
  isOpen       Boolean   @default(true)

  updatedAt DateTime @updatedAt
}

// Singleton row (id is always "singleton") behind the admin Payments tab:
// how to pay, what it costs, and whether the early-bird discount is running.
//
// Split out of RegisterFormConfig rather than added to it because it has its
// own admin surface, following the one-singleton-per-tab shape already used by
// RegisterFormConfig and CompetitionDayConfig.
model PaymentConfig {
  id String @id @default("singleton")

  /// CliQ payment details, all admin-supplied.
  ///
  /// Off by default and blank: nobody but the committee knows the chapter's
  /// alias, and a payment panel showing a placeholder would send money to
  /// nowhere. The payment stage shows nothing until this is filled in and
  /// switched on.
  paymentEnabled  Boolean @default(false)
  cliqAlias       String  @default("")
  /// ALIAS or MOBILE — banking apps ask which kind of CliQ identifier this is.
  cliqAliasType   String  @default("ALIAS")
  cliqBankName    String  @default("")
  cliqAccountName String  @default("")
  /// Anything else the team needs to know, shown under the details.
  paymentNote     String  @default("")

  /// Flat per-team price for each tier, in fils (1 JOD = 1000) so money is
  /// never a float. Defaults mirror the fee text the site has shown all along.
  priceRasMemberFils  Int @default(15000)
  priceIeeeMemberFils Int @default(25000)
  priceNonMemberFils  Int @default(35000)

  /// Early-bird discount: a percentage off every tier until the cutoff passes.
  ///
  /// The cutoff expires the discount on its own, so nobody has to remember to
  /// switch it off; `earlyBirdEnabled` is a manual kill switch for ending it
  /// early. A null cutoff means the discount never applies, even when enabled —
  /// safer than treating "no date" as "forever".
  earlyBirdEnabled Boolean   @default(false)
  earlyBirdPercent Int       @default(0)
  earlyBirdCutoff  DateTime?

  updatedAt DateTime @updatedAt
}

// The organising committee, as shown on the public Team page.
//
// Named CommitteeMember rather than TeamMember because TeamMember is already
// taken, and by something entirely different: the people on a *competing*
// team's registration. Two models called "team member" meaning "an entrant"
// and "an organiser" would be a permanent source of the wrong query.
model CommitteeDepartment {
  id          String   @id @default(cuid())
  name        String
  /// Short line under the department heading. Optional.
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CommitteeMember[]
}

model CommitteeMember {
  id   String @id @default(cuid())
  name String
  /// The job as written on the page — "Chair", "Head of Logistics", "Designer".
  ///
  /// Free text, and deliberately separate from `rank`. Rank is the structure
  /// the page is built from and has four values; role is what this person is
  /// actually called, which no fixed list would ever cover.
  role String @default("")

  /// Where this person sits in the hierarchy. Values live in src/lib/roster.ts,
  /// the same pattern as PaymentStatus and BroadcastList.kind.
  rank String @default("MEMBER")

  /// Null for the chair and co-chair, who sit above the departments.
  departmentId String?
  department   CommitteeDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// Public URL of the portrait, and the storage key kept so deleting the row
  /// can delete the file too — the same pair, for the same reason, as
  /// GalleryPhoto.
  photoUrl String?
  photoKey String?

  /// The honourable mention shown when this person is opened on /team.
  ///
  /// Blank is meaningful and is the default: it means no popup for them, and
  /// the card on the public page stays a plain card rather than becoming a
  /// button that opens an empty stage.
  tribute String @default("")

  /// The backdrop behind them in that popup, and the storage key kept so
  /// deleting the row can delete the file too — the same pair, for the same
  /// reason, as photoUrl/photoKey above.
  ///
  /// Null is not a missing stage. Everybody has one: with no upload the popup
  /// composes a stage from their id, so no two people share a backdrop even
  /// before a single picture has been uploaded.
  stageUrl String?
  stageKey String?

  /// Hidden members stay in the admin list but leave the public page, so
  /// somebody can be added before an announcement without being visible.
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([departmentId])
  @@index([isPublished])
}

/// A link at the foot of the build guide: a video, a playlist or a site.
///
/// `kind` is a plain String, the same tradeoff as Registration.status, held to
/// VIDEO | PLAYLIST | SITE by ReferenceKind in src/lib/references.ts. Anything
/// else is read back as a website rather than crashing a public page.
///
/// The first seven rows are inserted by the migration rather than by the seed,
/// because the seed runs on every deploy: a starter link the committee deleted
/// would come back on the next push, which is not what a Remove button means.
model MicromouseReference {
  id    String @id @default(cuid())
  kind  String @default("SITE")
  title String
  url   String

  /// The channel or the site it comes from, shown under the title.
  author String @default("")
  /// Why it is worth the reader's time, in the committee's words.
  note   String @default("")

  /// Hidden references stay in the admin list but leave the public page.
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// A sponsor of the competition, shown on the hall screen's sponsors slide and
// edited on the Sponsors desk in Day HQ.
model Sponsor {
  id          String   @id @default(cuid())
  name        String
  // A label to group by, "Gold sponsor" or "Media partner". Empty for none.
  tier        String   @default("")
  website     String   @default("")
  // The logo in blob storage, and its key so replacing or deleting the
  // sponsor removes the file too. Empty for a sponsor shown by name.
  logoUrl     String   @default("")
  logoKey     String   @default("")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}
